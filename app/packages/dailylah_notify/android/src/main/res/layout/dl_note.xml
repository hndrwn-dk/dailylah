<?xml version="1.0" encoding="utf-8"?>
<!-- One alert notification: title, body, a small picture and up to three pills. Only views
     every notification shade supports. Six pill slots in three rows: the poster fills them
     row by row (NotePoster.kt), so pills wrap without measuring. Kept by hand: view ids are
     used in the Kotlin. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/dl_note_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <TextView
        android:id="@+id/dl_note_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="5"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />

        <LinearLayout
            android:id="@+id/dl_note_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView
                android:id="@+id/dl_note_art"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <TextView
                android:id="@+id/dl_note_pill_1a"
                style="@style/DlNotePill" />
            <TextView
                android:id="@+id/dl_note_pill_1b"
                style="@style/DlNotePill"
                android:layout_marginStart="6dp" />
            <TextView
                android:id="@+id/dl_note_pill_1c"
                style="@style/DlNotePill"
                android:layout_marginStart="6dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dl_note_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/dl_note_pill_2a"
                style="@style/DlNotePill" />
            <TextView
                android:id="@+id/dl_note_pill_2b"
                style="@style/DlNotePill"
                android:layout_marginStart="6dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dl_note_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/dl_note_pill_3a"
                style="@style/DlNotePill" />
        </LinearLayout>
</LinearLayout>

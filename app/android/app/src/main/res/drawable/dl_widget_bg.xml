<?xml version="1.0" encoding="utf-8"?>
<!-- Sticker card like Panel in lib/ui/widgets.dart: ink outline, hard shadow 3dp down-right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dl_w_shadow" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dl_w_card" />
            <stroke android:width="2dp" android:color="@color/dl_w_edge" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>

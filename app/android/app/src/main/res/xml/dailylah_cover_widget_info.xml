<?xml version="1.0" encoding="utf-8"?>
<!-- Same widget for the Galaxy Z Flip cover screen (Flex Window). Samsung lists keyguard widgets
     with the sub_screen meta-data (samsung_dailylah_cover_widget.xml) under Settings > Cover screen >
     Widgets. 352x339 dp is the Flex Window widget area. Other phones never show a keyguard-only widget. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/dl_widget_empty"
    android:previewLayout="@layout/dl_widget_preview"
    android:minWidth="352dp"
    android:minHeight="339dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="keyguard" />

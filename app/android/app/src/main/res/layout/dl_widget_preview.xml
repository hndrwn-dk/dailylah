<?xml version="1.0" encoding="utf-8"?>
<!-- DailyLahWidgetProvider.kt picks this layout by widget size; keep view ids in sync. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dl_widget_bg"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="15dp"
    android:paddingBottom="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/dl_w_mist"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="@string/widget_sample_header"
                android:letterSpacing="0.06"
                android:textAllCaps="true" />
            <TextView
                android:id="@+id/w_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/dl_w_mist"
                android:textSize="11sp"
                android:text="@string/widget_sample_updated"
                android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_wx_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/dl_w_panel_amber"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">
            <ImageView
                android:id="@+id/w_wx_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dl_wx_thunder"
                android:tint="@color/dl_w_ink" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/w_wx_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:maxLines="1"
                    android:textColor="@color/dl_w_ink"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:text="@string/widget_sample_wx" />
                <TextView
                    android:id="@+id/w_wx_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/dl_w_ink"
                    android:textSize="12sp"
                    android:text="@string/widget_sample_note" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_mrt_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/dl_w_row_none"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp">
            <ImageView
                android:id="@+id/w_mrt_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dl_ic_w_train"
                android:tint="@color/dl_w_text" />
            <ImageView
                android:id="@+id/w_mrt_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dl_w_dot_ok" />
            <TextView
                android:id="@+id/w_mrt_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/dl_w_text"
                android:textSize="14sp"
                android:text="@string/widget_sample_mrt"
                android:layout_marginStart="6dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_line3_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/dl_w_row_go"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp">
            <ImageView
                android:id="@+id/w_line3_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dl_ic_w_bus_go" />
            <TextView
                android:id="@+id/w_line3_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/dl_w_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="@string/widget_sample_bus"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

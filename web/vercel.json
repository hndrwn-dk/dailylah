{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/privacy",
      "destination": "https://www.tursinalabs.com/dailylah/privacy",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "https://www.tursinalabs.com/dailylah/terms",
      "permanent": false
    }
  ]
}

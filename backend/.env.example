# Copy to .env for local dev. Never commit .env.
ENV=dev
DATAGOV_API_KEY=
LTA_ACCOUNT_KEY=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
URA_ACCESS_KEY=
GEOAPIFY_API_KEY=
# Optional: DailyLah's share of the Geoapify daily credits (keep it below the key's daily cap,
# the daily data build uses the same key), the share when Redis is off, calls per second, and
# one client's calls per window (seconds).
# PLACES_DAILY_BUDGET=1900
# PLACES_MEMORY_BUDGET=50
# PLACES_PER_SECOND=4
# PLACES_CLIENT_LIMIT=60
# PLACES_CLIENT_WINDOW=3600
REDIS_URL=
DATABASE_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
PUBLIC_BASE_URL=http://localhost:8000
